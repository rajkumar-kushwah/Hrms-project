generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id                           String                        @id @default(uuid())
  name                         String
  code                         String                        @unique
  email                        String?
  phone                        String?
  website                      String?
  address                      String?
  logo                         String?
  isActive                     Boolean                       @default(true)
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  gstNumber                    String?
  maxBranches                  Int                           @default(1)
  maxEmployees                 Int                           @default(10)
  subscriptionEnd              DateTime?
  subscriptionPlan             String                        @default("basic")
  attendances                  Attendance[]
  branches                     Branch[]
  categories                   Category[]
  companySettings              CompanySettings?
  holidays                     Holiday[]
  leaveRequests                LeaveRequest[]
  leaveTypes                   LeaveType[]
  onboardings                  Onboarding[]
  onboardingChecklistTemplates OnboardingChecklistTemplate[]
  permission                   Permission[]
  role                         Role[]
  users                        User[]
}

model User {
  id                    String           @id @default(uuid())
  name                  String?
  email                 String           @unique
  password              String
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  lastLogin             DateTime?
  isActive              Boolean          @default(true)
  companyId             String?
  roleId                Int?
  createdBy             String?
  branchId              String?
  categoryId            String?
  designation           String?
  employeeCode          String?          @unique
  joiningDate           DateTime?
  phone                 String?
  aadharNumber          String?
  bankAccountNumber     String?
  bankIFSC              String?
  bankName              String?
  bloodGroup            String?
  currentAddress        String?
  dateOfBirth           DateTime?
  emergencyContactName  String?
  emergencyContactPhone String?
  employmentType        String?
  esiNumber             String?
  gender                String?
  maritalStatus         String?
  panNumber             String?
  permanentAddress      String?
  pfNumber              String?
  profilePhoto          String?
  reportingManagerId    String?
  workShift             String?
  grossSalary           Float?
  employmentStatus      EmploymentStatus @default(ONBOARDING)
  attendances           Attendance[]
  approvedLeaves        LeaveRequest[]   @relation("ApprovedLeaves")
  leaveRequests         LeaveRequest[]   @relation("LeaveRequests")
  onboarding            Onboarding?
  payrolls              Payroll[]
  branch                Branch?          @relation(fields: [branchId], references: [id])
  category              Category?        @relation(fields: [categoryId], references: [id])
  company               Company?         @relation(fields: [companyId], references: [id])
  createdByUser         User?            @relation("CreatedBy", fields: [createdBy], references: [id])
  createdUsers          User[]           @relation("CreatedBy")
  reportingManager      User?            @relation("ReportingManager", fields: [reportingManagerId], references: [id])
  teamMembers           User[]           @relation("ReportingManager")
  role                  Role?            @relation(fields: [roleId], references: [id])
}

model Role {
  id                 Int          @id @default(autoincrement())
  name               String
  description        String?
  isActive           Boolean      @default(true)
  companyId          String?
  isSystemRole       Boolean      @default(false)
  requiresOnboarding Boolean      @default(true)
  permissions        Permission[]
  company            Company?     @relation(fields: [companyId], references: [id])
  user               User[]

  @@unique([name, companyId])
}

model Module {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  displayName String
  icon        String
  url         String
  parentId    Int?
  order       Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  parent      Module?      @relation("SubModules", fields: [parentId], references: [id])
  children    Module[]     @relation("SubModules")
  permission  Permission[]
}

model Permission {
  id        Int      @id @default(autoincrement())
  roleId    Int
  moduleId  Int
  companyId String?
  canView   Boolean  @default(false)
  canCreate Boolean  @default(false)
  canEdit   Boolean  @default(false)
  canDelete Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company? @relation(fields: [companyId], references: [id])
  module    Module   @relation(fields: [moduleId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])

  @@unique([roleId, moduleId, companyId])
}

model Branch {
  id           String       @id @default(uuid())
  name         String
  code         String
  address      String?
  phone        String?
  email        String?
  city         String?
  state        String?
  pincode      String?
  managerName  String?
  latitude     Float?
  longitude    Float?
  geoRadius    Float?
  isActive     Boolean      @default(true)
  companyId    String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  locationName String?
  attendances  Attendance[]
  company      Company      @relation(fields: [companyId], references: [id])
  categories   Category[]
  users        User[]

  @@unique([code, companyId])
}

model Category {
  id          String   @id @default(uuid())
  name        String
  description String
  isActive    Boolean  @default(true)
  companyId   String
  branchId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  branch      Branch   @relation(fields: [branchId], references: [id])
  company     Company  @relation(fields: [companyId], references: [id])
  users       User[]

  @@unique([name, branchId])
}

model Attendance {
  id               String    @id @default(uuid())
  userId           String
  companyId        String
  branchId         String
  date             DateTime
  punchInTime      DateTime?
  punchOutTime     DateTime?
  punchInLat       Float?
  punchInLng       Float?
  punchOutLat      Float?
  punchOutLng      Float?
  isWithinGeoFence Boolean   @default(true)
  status           String    @default("Present")
  workingHours     Float?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  branch           Branch    @relation(fields: [branchId], references: [id])
  company          Company   @relation(fields: [companyId], references: [id])
  user             User      @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model CompanySettings {
  id               String   @id @default(uuid())
  companyId        String   @unique
  lateMarkHour     Int      @default(10)
  lateMarkMinute   Int      @default(15)
  halfDayHours     Float    @default(4)
  defaultGeoRadius Float    @default(100)
  weekOffDays      Int[]    @default([0])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  company          Company  @relation(fields: [companyId], references: [id])
}

model LeaveType {
  id           String         @id @default(uuid())
  name         String
  description  String?
  daysPerYear  Int            @default(12)
  isActive     Boolean        @default(true)
  companyId    String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  isPaid       Boolean        @default(true)
  leaveRequest LeaveRequest[]
  company      Company        @relation(fields: [companyId], references: [id])
}

model LeaveRequest {
  id             String    @id @default(uuid())
  userId         String
  leaveTypeId    String
  companyId      String
  startDate      DateTime
  endDate        DateTime
  totalDays      Float
  reason         String?
  status         String    @default("Pending")
  approvedBy     String?
  approvedAt     DateTime?
  rejectReason   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  approvedByUser User?     @relation("ApprovedLeaves", fields: [approvedBy], references: [id])
  company        Company   @relation(fields: [companyId], references: [id])
  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id])
  user           User      @relation("LeaveRequests", fields: [userId], references: [id])
}

model Payroll {
  id                  String        @id @default(uuid())
  userId              String
  year                Int
  grossSalary         Float
  workingDays         Int
  presentDays         Int
  paidLeaveDays       Int
  unpaidLeaveDays     Int
  absentDays          Int
  unpaidDeduction     Float
  netSalary           Float
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  month               Int
  holidayDays         Int           @default(0)
  confirmedAt         DateTime?
  earnedSalary        Float         @default(0)
  elapsedCalendarDays Int           @default(0)
  paidAt              DateTime?
  payableDays         Int           @default(0)
  paymentRef          String?
  perDaySalary        Float         @default(0)
  status              PayrollStatus @default(DRAFT)
  totalDaysInMonth    Int           @default(0)
  user                User          @relation(fields: [userId], references: [id])

  @@unique([userId, month, year])
}

model Holiday {
  id        String   @id @default(uuid())
  name      String
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  companyId String
  isActive  Boolean  @default(true)
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, date])
}

model Session {
  sid    String   @id
  sess   Json
  expire DateTime

  @@index([expire])
  @@map("sessions")
}

model Onboarding {
  id           String                    @id @default(uuid())
  userId       String                    @unique
  companyId    String
  currentStage OnboardingStage           @default(OFFER)
  status       OnboardingStatus          @default(IN_PROGRESS)
  startDate    DateTime                  @default(now())
  targetDate   DateTime?
  completedAt  DateTime?
  notes        String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  company      Company                   @relation(fields: [companyId], references: [id])
  user         User                      @relation(fields: [userId], references: [id])
  items        OnboardingChecklistItem[]

  @@index([companyId])
}

model OnboardingChecklistItem {
  id                String                       @id @default(uuid())
  onboardingId      String
  templateId        String?
  stage             OnboardingStage
  title             String
  description       String?
  isRequired        Boolean                      @default(true)
  order             Int                          @default(0)
  isCompleted       Boolean                      @default(false)
  completedAt       DateTime?
  completedBy       String?
  requiresDocument  Boolean                      @default(false)
  documentUrl       String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  documentInputType DocumentInputType?
  documentNumber    String?
  onboarding        Onboarding                   @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  template          OnboardingChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([onboardingId])
}

model OnboardingChecklistTemplate {
  id                String                    @id @default(uuid())
  companyId         String
  stage             OnboardingStage
  title             String
  description       String?
  isRequired        Boolean                   @default(true)
  order             Int                       @default(0)
  requiresDocument  Boolean                   @default(false)
  isActive          Boolean                   @default(true)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  documentInputType DocumentInputType?
  company           Company                   @relation(fields: [companyId], references: [id])
  onboardingItems   OnboardingChecklistItem[]

  @@index([companyId, stage])
}

enum PayrollStatus {
  DRAFT
  CONFIRMED
  PAID
}

enum OnboardingStage {
  OFFER
  JOINING
  DOCUMENTS
  TRAINING
  ACTIVE
}

enum EmploymentStatus {
  ONBOARDING
  ACTIVE
  INACTIVE
}

enum OnboardingStatus {
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum DocumentInputType {
  FILE_UPLOAD
  DOCUMENT_NUMBER
  EITHER
}
